node_modules/

# Git Bash on Windows drops these
*.stackdump

# HA writes its database, logs, secrets and .storage into the dev config dir.
# Keep the one file we author, ignore everything else it generates.
dev/config/*
!dev/config/configuration.yaml

# Build output lands inside the ignored dev config tree, but be explicit.
dev/config/www/

# The household roster is the operator every fork has their own.
# It is served from config/www/hacalendar-config/ in production and is
# never part of the build or the repo. public/people.json is only a
# convenience for `vite dev`.
public/people.json
